# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/INOVIQ-SIKAR?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/INOVIQ-SIKAR?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/INOVIQ-SIKAR?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=INOVIQ_super_secure_jwt_token_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Optional: Email Notifications (Nodemailer)
# If left blank, inquiries are stored safely in MongoDB and email notifications are skipped gracefully.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@INOVIQglobal.com
ADMIN_NOTIFICATION_EMAIL=inquiries@INOVIQglobal.com

# Company Information (Configurable placeholders)
COMPANY_NAME=INOVIQ GLOBAL PVT. LTD.
COMPANY_EMAIL=info@inoviqglobal.com
COMPANY_PHONE=+91 80001 80600
COMPANY_ADDRESS=Corporate Towers, Tech Corridor, Sikar, Rajasthan, India
